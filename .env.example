# Resend API key — get from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email where you receive signup notifications
WAITLIST_NOTIFY_EMAIL=your@email.com

# Verified sender address in your Resend account
WAITLIST_FROM_EMAIL=waitlist@yourdomain.com

# Optional: Resend Audience ID for contact list deduplication
RESEND_AUDIENCE_ID=
