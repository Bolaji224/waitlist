# Klaviyo private API key — Settings → API Keys → Create Private Key (Full Access)
# Never commit the real value. Add it only in Vercel environment variables.
KLAVIYO_PRIVATE_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Klaviyo List ID for the waitlist — Lists & Segments → your list → Settings → List ID
KLAVIYO_WAITLIST_LIST_ID=XXXXXX
